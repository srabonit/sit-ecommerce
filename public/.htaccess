<IfModule mod_rewrite.c>
    <IfModule mod_negotiation.c>
        Options -MultiViews -Indexes +FollowSymLinks
    </IfModule>

    RewriteEngine On

    # =========================================================================
    # UNIVERSAL IMAGE AUTO-RESOLVER (Localhost & Live Server)
    # =========================================================================

    # 1. Jodi URL-e /storage/uploads/... thake kintu real file ache uploads/... e
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^storage/uploads/(.*)$ uploads/$1 [L,NC]

    # 2. Jodi URL-e /storage/... thake kintu real file ache uploads/... e
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^storage/(.*)$ uploads/$1 [L,NC]

    # 3. Jodi URL-e direct /products/... call hoy kintu real file ache uploads/products/... e (Local fix)
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^products/(.*)$ uploads/products/$1 [L,NC]

    # 4. Jodi URL-e /uploads/products/... thake kintu file ache direct products/... e
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^uploads/products/(.*)$ products/$1 [L,NC]

    # =========================================================================
    # DEFAULT LARAVEL HANDLERS
    # =========================================================================

    # Handle Authorization Header
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # Handle X-XSRF-Token Header
    RewriteCond %{HTTP:x-xsrf-token} .
    RewriteRule .* - [E=HTTP_X_XSRF_TOKEN:%{HTTP:X-XSRF-Token}]

    # Redirect Trailing Slashes If Not A Folder...
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_URI} (.+)/$
    RewriteRule ^ %1 [L,R=301]

    # Send Requests To Front Controller...
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^ index.php [L]
</IfModule>